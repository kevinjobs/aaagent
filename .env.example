# LLM API Keys (all keys are read from .env, never written to logs)

OPENAI_API_KEY=        # OpenAI official (https://api.openai.com)
DEEPSEEK_API_KEY=      # DeepSeek (https://api.deepseek.com)
CNTOKEN_API_KEY=       # cntoken world (https://www.cntokenworld.com/api/aistore/v1)
MINMAX_API_KEY=        # MiniMax (https://api.minimaxi.com/v1, OpenAI-compatible)

# Feishu
FEISHU_APP_ID=         # App ID from https://open.feishu.cn/app
FEISHU_APP_SECRET=     # App secret

# Debug toggles
FEISHU_DEBUG=          # Set to 1 / true / yes to enable verbose Feishu frame logs

# All API keys are only used locally for LLM calls and are redacted in
# debug-level config logs by Application._redact_yaml.